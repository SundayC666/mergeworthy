# OpenAI API Configuration (Option 1 - Recommended if you have credits)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Alternative: Use Ollama for completely free local LLM
# Just install Ollama from https://ollama.ai and run: ollama pull llama2
# Then set USE_OLLAMA=true
USE_OLLAMA=false
OLLAMA_MODEL=llama2

# NVD API Key (Optional - increases rate limit from 5 to 50 requests per 30 seconds)
# Get free key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Harness (harness/llm.py): models under test
# HARNESS_PROVIDER=gateway uses the Duke AI Gateway and needs DUKE_API_KEY.
# HARNESS_PROVIDER=ollama uses local Ollama at http://localhost:11434 and needs no key.
HARNESS_PROVIDER=gateway
DUKE_API_KEY=
