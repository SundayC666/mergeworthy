# Copy to .env and fill in. Never commit .env.

# --- Harness (harness/llm.py): the models under test -----------------------------
# gateway = Duke AI Gateway (needs DUKE_API_KEY and the Duke VPN); ollama = local, no key.
HARNESS_PROVIDER=gateway
DUKE_API_KEY=
# DUKE_BASE_URL=https://litellm.oit.duke.edu/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Web app (app/core/config.py) -------------------------------------------------
# NVD API key is optional; it raises the NVD rate limit from 5 to 50 requests / 30 s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# HOST=127.0.0.1
# PORT=8000
# DEBUG=false
